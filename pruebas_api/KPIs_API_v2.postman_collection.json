{
 "info": {
  "name": "KPIs Gimnasio - API de carga (v2)",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
  "description": "Variables: base_url (ej. http://ricnas-syslinux.tail95bb82.ts.net:8080), token_escritura, token_lectura. La API SOLO agrega registros nuevos y consulta; no modifica ni borra (eso se hace en el tablero, pantalla Revisión). Todo lo que carga queda sin revisar. Un cierre trae UN registro con sus 5 montos; el total lo calcula la base."
 },
 "variable": [
  {
   "key": "base_url",
   "value": "http://localhost:8080"
  },
  {
   "key": "token_escritura",
   "value": "PEGA_AQUI_API_TOKEN_ESCRITURA"
  },
  {
   "key": "token_lectura",
   "value": "PEGA_AQUI_API_TOKEN_LECTURA"
  }
 ],
 "item": [
  {
   "name": "Salud (sin clave)",
   "request": {
    "method": "GET",
    "header": [],
    "url": {
     "raw": "{{base_url}}/salud",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "salud"
     ]
    }
   }
  },
  {
   "name": "Estado de la base",
   "request": {
    "method": "GET",
    "header": [
     {
      "key": "Authorization",
      "value": "Bearer {{token_lectura}}",
      "type": "text"
     }
    ],
    "url": {
     "raw": "{{base_url}}/api/v1/estado",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "api",
      "v1",
      "estado"
     ],
     "query": []
    },
    "description": ""
   }
  },
  {
   "name": "Agregar un cierre de ingresos",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Authorization",
      "value": "Bearer {{token_escritura}}",
      "type": "text"
     },
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": {
     "raw": "{{base_url}}/api/v1/ingresos",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "api",
      "v1",
      "ingresos"
     ],
     "query": []
    },
    "description": "Responde agregado. Si lo reenvías igual: sin_cambios. Con otros montos y el mismo id_origen: 409. Si ya hay otro cierre de la misma fecha y turno: 409.",
    "body": {
     "mode": "raw",
     "raw": "{\n  \"fecha\": \"2026-11-28\",\n  \"turno\": \"M\",\n  \"personal\": \"Jeremy\",\n  \"mem_efectivo\": 1450,\n  \"mem_electronico\": 0,\n  \"mer_efectivo\": 72,\n  \"mer_electronico\": 30,\n  \"excedente\": -4,\n  \"id_origen\": \"msg-ingresos-0001\",\n  \"estado\": \"verde\",\n  \"observaciones\": null,\n  \"fuente\": {\n    \"chat\": \"ingresos\",\n    \"mensajes\": [\n      \"IMG-1\",\n      \"IMG-2\"\n    ]\n  }\n}",
     "options": {
      "raw": {
       "language": "json"
      }
     }
    }
   }
  },
  {
   "name": "Agregar un gasto",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Authorization",
      "value": "Bearer {{token_escritura}}",
      "type": "text"
