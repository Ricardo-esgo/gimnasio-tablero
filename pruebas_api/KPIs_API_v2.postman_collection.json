      "egresos"
     ],
     "query": []
    },
    "description": "id_origen es obligatorio en egresos (por ejemplo el id del mensaje del chat). Categoría nueva o posible duplicado: se carga y queda en amarillo con la advertencia.",
    "body": {
     "mode": "raw",
     "raw": "{\n  \"fecha\": \"2026-11-28\",\n  \"personal\": \"Ricardo\",\n  \"tipo\": \"Insumos\",\n  \"concepto\": \"Cloro y trapeadores\",\n  \"efectivo\": 320.5,\n  \"electronico\": 0,\n  \"id_origen\": \"msg-egresos-0001\",\n  \"estado\": \"verde\"\n}",
     "options": {
      "raw": {
       "language": "json"
      }
     }
    }
   }
  },
