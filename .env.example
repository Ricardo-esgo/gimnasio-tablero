# Copia este archivo como ".env" (junto a docker-compose.yml) y ajusta los valores.

# OBLIGATORIA. Imagen publicada en GitHub (usuario y repositorio en minúsculas).
# Para fijar una versión usa, por ejemplo, :1.0.0 en lugar de :latest.
IMAGEN=ghcr.io/tu-usuario/gimnasio-tablero:latest

# OBLIGATORIA. Carpeta del servidor donde está el Excel (la carpeta, no el archivo).
# Ejemplo en OpenMediaVault: /srv/dev-disk-by-uuid-XXXX/gimnasio
EXCEL_RUTA_HOST=/srv/dev-disk-by-uuid-XXXX/gimnasio

# Nombre del archivo Excel dentro de esa carpeta.
EXCEL_ARCHIVO=Data_Base.xlsx

# Texto largo y secreto para firmar las sesiones (por ejemplo, el resultado de: openssl rand -hex 32).
SESSION_SECRET=cambia-esto-por-un-texto-largo-y-secreto

# Opcionales
PUERTO=8080
SESSION_HORAS=12
COOKIE_SECURE=false
TZ=America/Mexico_City
# Usuario y grupo con permiso de lectura sobre la carpeta del Excel (en OMV el grupo "users" es 100).
PUID=1000
PGID=100
