# Copia este archivo como ".env" (junto a docker-compose.yml) y ajusta los valores.

# OBLIGATORIA. Imagen publicada en GitHub (usuario y repositorio en minúsculas).
IMAGEN=ghcr.io/tu-usuario/gimnasio-tablero:latest

# OBLIGATORIA. Carpeta del servidor donde vivirá la base de datos (kpis.db), sus respaldos y,
# la primera vez, el Excel con el que se llena. La carpeta, no un archivo. Debe poder ESCRIBIRSE.
# Ejemplo en OpenMediaVault: /srv/dev-disk-by-uuid-XXXX/DB_KPIS
DATOS_RUTA_HOST=/srv/dev-disk-by-uuid-XXXX/DB_KPIS

# Excel con el que se llena la base la PRIMERA vez (si la base está vacía). Debe estar en esa misma carpeta.
EXCEL_ARCHIVO=Data_Base.xlsx

# Texto largo y secreto para firmar las sesiones (por ejemplo, el resultado de: openssl rand -hex 32).
SESSION_SECRET=cambia-esto-por-un-texto-largo-y-secreto

# Claves de la API de carga (cada una, un texto largo distinto; por ejemplo: openssl rand -hex 24).
# Sin API_TOKEN_ESCRITURA la API de carga queda apagada (el tablero funciona igual).
API_TOKEN_ESCRITURA=cambia-esto-por-un-texto-largo-y-secreto
API_TOKEN_LECTURA=

# Opcionales
PUERTO=8080
SESSION_HORAS=12
COOKIE_SECURE=false
TZ=America/Mexico_City
RESPALDO_HORAS=24
RESPALDOS_CONSERVAR=14
# Usuario y grupo con que corre el contenedor (deben poder escribir en la carpeta de datos).
PUID=1007
PGID=1007
